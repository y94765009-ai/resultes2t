const newCode=()=>'HP-'+Array.from({length:5},()=>'ABCDEFGHJKMNPQRSTUVWXYZ23456789'[Math.floor(Math.random()*31)]).join('');

/* =================== المعالج =================== */
function startWizard(mode){
  const le=lastEntry();
  W={mode,step:mode==='measures'?4:0,A:le?{...le.A}:{},M:le?{...le.M}:{},year:le?le.year:null,sex:le?le.sex:null,age:le?le.age:null};
  if(mode==='followup'&&!le&&P.recovered){W.A={};W.M={};}
  view='wizard'; setNav(false); renderWizard();
}
function chipsFor(f,cur){ return QS[f].o.map(o=>`<button type="button" class="chip${cur===o.v?' on':''}" data-f="${f}" data-v="${o.v}">${o.l}</button>`).join(''); }
function renderWizard(keep){
  const y=window.scrollY,s=STEPS[W.step];
  $('top').innerHTML=topbar();
  let body='';
  if(s.q){
    body=s.q.map(f=>{
      const q=QS[f];
      if(q.show&&!q.show(W.A))return '';
      const cur=(f==='year'||f==='sex')?W[f]:W.A[f];
      return `<div class="q" data-f="${f}"><div class="ql">${q.l}</div>${q.h?`<div class="hint">${q.h}</div>`:''}<div class="chips">${chipsFor(f,cur)}</div></div>`;
    }).join('');
    if(s.age)body+=`<div class="q" data-f="age"><div class="ql">السن</div><input type="number" id="age" min="17" max="45" inputmode="numeric" placeholder="مثال: 20" value="${W.age||''}"></div>`;
  } else {
    body=`<p class="sub">اختيارية، وغالبًا يسجلها فريق الفحص. اترك الحقل فارغًا إن لم يكن متاحًا. كلما زادت القياسات أصبحت درجتك أدق.</p><div class="grid2">`+
      MF.map(([k,l,ph])=>`<div><label class="f">${l}</label><input type="number" id="m_${k}" step="any" inputmode="decimal" placeholder="${ph}" value="${W.M[k]??''}"></div>`).join('')+`</div>`;
  }
  const last=W.step===STEPS.length-1;
  $('app').innerHTML=`<div class="prog">${STEPS.map((_,i)=>`<i class="${i<=W.step?'on':''}"></i>`).join('')}</div>
  <div class="card"><h2>${s.t}</h2>${body}
  <div class="btns">${W.step>0&&W.mode!=='measures'?'<button class="btn sec" id="pv">السابق</button>':'<button class="btn sec" id="cx">إلغاء</button>'}
  <button class="btn pri" id="nx">${last?'احسب نتيجتي':'التالي'}</button></div></div>`;
  document.querySelectorAll('.chip').forEach(b=>b.onclick=()=>{
    const f=b.dataset.f,o=QS[f].o.find(x=>String(x.v)===b.dataset.v);
    if(f==='year'||f==='sex')W[f]=o.v; else W.A[f]=o.v;
    if(f==='smoke'){ if(W.A.smoke!=='former')delete W.A.quit; keepAge(); renderWizard(true); return; }
    b.parentNode.querySelectorAll('.chip').forEach(x=>x.classList.toggle('on',x===b));
    b.closest('.q').classList.remove('err');
  });
  if($('pv'))$('pv').onclick=()=>{keepAge();W.step--;renderWizard();window.scrollTo({top:0});};
  if($('cx'))$('cx').onclick=()=>{ if(lastEntry())goApp('dash'); else { store.clear(); P=null; startWelcome(); } };
  $('nx').onclick=nextStep;
  window.scrollTo({top:keep?y:0});
}
function keepAge(){ if($('age')){const a=+$('age').value; if(a)W.age=a;} }
function nextStep(){
  const s=STEPS[W.step]; let bad=[];
  if(s.q){
    s.q.forEach(f=>{const q=QS[f]; if(q.show&&!q.show(W.A))return; const v=(f==='year'||f==='sex')?W[f]:W.A[f]; if(v===undefined||v===null)bad.push(f);});
    if(s.age){const a=+$('age').value; if(!(a>=17&&a<=45))bad.push('age'); else W.age=a;}
    document.querySelectorAll('.q').forEach(q=>q.classList.toggle('err',bad.includes(q.dataset.f)));
    if(bad.length){const e=document.querySelector('.q.err'); if(e)e.scrollIntoView({behavior:'smooth',block:'center'}); return;}
    W.step++; renderWizard(); return;
  }
  const M={};
  for(const [k,,,lo,hi] of MF){ const v=$('m_'+k).value.trim(); if(v==='')continue; const n=+v; if(!(n>=lo&&n<=hi)){alert('يرجى مراجعة القياسات: توجد قيمة خارج المدى المنطقي.');return;} M[k]=n; }
  if((M.sbp==null)!==(M.dbp==null)){alert('أدخل الضغط الانقباضي والانبساطي معًا أو اتركهما فارغين.');return;}
  if((M.tc==null)!==(M.hdl==null)){alert('أدخل الكوليسترول الكلي وHDL معًا أو اتركهما فارغين.');return;}
  if(M.tc!=null&&M.hdl>=M.tc){alert('الكوليسترول HDL يجب أن يكون أقل من الكلي.');return;}
  W.M=M; finishWizard();
}
function finishWizard(){
  const res=compute(W.A,W.M,W.age,W.sex);
  const round=(!P.entries.length&&!P.recovered)?'baseline':'followup';
  const entry={ts:Date.now(),round,year:W.year,sex:W.sex,age:W.age,A:{...W.A},M:{...W.M},total:res.total,sc:res.sc,n:res.n};
  if(W.mode==='measures'&&P.entries.length){ const le=lastEntry(); entry.round=le.round; entry.ts=le.ts; P.entries[P.entries.length-1]=entry; }
  else P.entries.push(entry);
  store.set(P);
  send(entry,res);
  goApp('dash');
}

/* =================== الشاشة الرئيسية ===================*/
function renderApp(){
  document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('on',b.dataset.t===tab));
  $('top').innerHTML=topbar();
  const le=lastEntry(); if(!le){startWelcome();return;}
  const res=compute(le.A,le.M,le.age,le.sex);
  $('app').innerHTML = tab==='dash'?dashHTML(le,res):tab==='goal'?goalHTML(le,res):meHTML(le,res);
  if(tab==='dash')bindDash(le,res); if(tab==='goal')bindGoal(le,res); if(tab==='me')bindMe(le,res);
}

/* ---- مخطط الرادار ---- */
function radar(sc){
  const cx=140,cy=140,R=86,n=8,pt=(i,r)=>{const a=-Math.PI/2+i*2*Math.PI/n;return [cx+r*Math.cos(a),cy+r*Math.sin(a)];};
  let g='';
  [.25,.5,.75,1].forEach(f=>{g+=`<polygon points="${MET.map((_,i)=>pt(i,R*f).join(',')).join(' ')}" fill="none" stroke="var(--line)" stroke-width="1"/>`;});
  MET.forEach((_,i)=>{const [x,y]=pt(i,R);g+=`<line x1="${cx}" y1="${cy}" x2="${x}" y2="${y}" stroke="var(--line)"/>`;});
  const pts=MET.map((m,i)=>pt(i,R*((sc[m.k]??0)/100)));
  g+=`<polygon points="${pts.map(p=>p.join(',')).join(' ')}" fill="rgba(198,145,46,.28)" stroke="var(--gold)" stroke-width="2.5" stroke-linejoin="round"/>`;
  MET.forEach((m,i)=>{
    const [x,y]=pts[i],has=sc[m.k]!==null;
    g+=`<circle cx="${x}" cy="${y}" r="${has?4.5:3}" fill="${has?colOf(sc[m.k]):'var(--card)'}" stroke="${has?'var(--card)':'var(--mut)'}" stroke-width="1.5"/>`;
    const [lx,ly]=pt(i,R+26);
    g+=`<text x="${lx}" y="${ly+6}" text-anchor="middle" font-size="19" opacity="${has?1:.4}">${m.i}</text>`;
  });
  return `<svg viewBox="0 0 280 280" width="100%" style="max-width:340px;display:block;margin:0 auto" role="img" aria-label="مخطط المؤشرات الثمانية">${g}</svg>`;
}

