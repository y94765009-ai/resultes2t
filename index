   ${sl('fast','أيام الوجبات السريعة أسبوعيًا',0,7,1,le.A.fast,' يوم')}
   ${sl('veg','أيام الخضار والفاكهة أسبوعيًا',0,7,1,le.A.veg,' يوم')}
   ${['cig','vape','both'].includes(le.A.smoke)?`<label class="chk"><input type="checkbox" id="sQuit"><span>ماذا لو أقلعت تمامًا عن التدخين والفيب؟</span></label>`:''}
   <div class="tiny" style="margin-top:8px">حساب تعليمي لتغيّر درجتك فقط، وليس توقعًا لخطر الإصابة بأي مرض.</div></div>

  <div class="card"><h3>☕ كافيين وملح (تقدير تقريبي)</h3>
   ${xbar('الكافيين اليومي',res.mg/CONFIG.CAFF_LIMIT,res.mg+' من '+CONFIG.CAFF_LIMIT+' مجم')}
   ${xbar('صوديوم الوجبات السريعة والمقليات والمخللات',res.na/CONFIG.SODIUM_LIMIT,res.na+' من '+CONFIG.SODIUM_LIMIT+' مجم')}
   <div class="tiny">أرقام تقريبية مبنية على متوسطات شائعة وتختلف حسب المنتج والكمية، ولا تدخل في درجتك.</div></div>

  <div id="peer"></div>
  ${P.entries.length===1&&!due?`<div class="note" style="margin-bottom:14px">📅 موعد المتابعة المقترح: <b>${fmtDate(dueDate)}</b> لترى أثر تغييرك.</div>`:''}
  <div class="btns noprint"><button class="btn sec" data-act="followup">تحديث بياناتي</button><button class="btn line" data-act="print">طباعة / PDF</button></div>
  <div class="foot">الأداة للتوعية والبحث العلمي ولا تُغني عن الفحص الطبي أو التشخيص.</div></div>`;
}
const sl=(f,l,a,b,st,v,u)=>`<div class="srow"><div class="t"><span>${l}</span><b id="v_${f}">${v}${u}</b></div><input type="range" data-f="${f}" data-u="${u}" min="${a}" max="${b}" step="${st}" value="${v}"></div>`;
function xbar(l,r,txt){const c=r>1?'var(--low)':r>.6?'var(--mid)':'var(--ok)';return `<div style="margin:10px 0"><div style="display:flex;justify-content:space-between;font-size:14px"><span>${l}</span><span>${txt}</span></div><div class="bar" style="height:10px"><i style="width:${clamp(r*100,0,100)}%;background:${c}"></i></div></div>`;}

function bindDash(le,res){
  document.querySelectorAll('.mc[data-m]').forEach(b=>b.onclick=()=>b.classList.toggle('open'));
  document.querySelectorAll('[data-act]').forEach(b=>b.onclick=()=>{
    const a=b.dataset.act;
    if(a==='followup')startWizard('followup'); else if(a==='measures')startWizard('measures');
    else if(a==='print')window.print();
    else if(a==='mkgoal'){setGoal(b.dataset.m);tab='goal';renderApp();window.scrollTo({top:0});}
  });
  const upd=()=>{
    const A={...le.A};
    document.querySelectorAll('.sim input[type=range]').forEach(r=>{A[r.dataset.f]=+r.value;$('v_'+r.dataset.f).textContent=r.value+r.dataset.u;});
    if($('sQuit')&&$('sQuit').checked){A.smoke='never';A.second=0;}
    const n=compute(A,le.M,le.age,le.sex).total,d=n-res.total;
    $('sNew').textContent=n; $('sNew').style.color=d>0?'var(--ok)':d<0?'var(--low)':'';
    $('sDiff').textContent=d>0?`تتحسن درجتك بمقدار ${d} نقطة`:d<0?`تنخفض درجتك ${-d} نقطة`:'';
  };
  document.querySelectorAll('.sim input').forEach(i=>i.addEventListener('input',upd));
  loadPeer(le,res);
}

/* =================== الهدف الأسبوعي =================== */
const GT={
  sleep:{t:'أنام 7 ساعات أو أكثر',n:5,i:'🌙'},
  act:{t:'أتحرك 30 دقيقة (مشي سريع أو رياضة)',n:4,i:'🏃'},
  diet:{t:'يوم بلا وجبات سريعة ولا مقليات',n:5,i:'🥗'},
  nic:{t:'يوم بلا تدخين أو فيب',n:7,i:'🚭'},
  water:{t:'أشرب 8 أكواب مياه',n:5,i:'💧'},
  energy:{t:'يوم بلا مشروبات طاقة',n:6,i:'⚡'}
};
function setGoal(k){
  if(P.goal)archiveGoal();
  P.goal={metric:k,text:GT[k].t,target:GT[k].n,start:iso(new Date()),done:{}}; store.set(P);
}
function archiveGoal(){
  const g=P.goal; if(!g)return;
  P.goalHistory=P.goalHistory||[]; P.goalHistory.push({metric:g.metric,start:g.start,target:g.target,count:Object.keys(g.done).length}); P.goal=null;
}
function suggestions(res){
  const le=lastEntry(),A=le.A,out=[];
  MET.filter(m=>m.beh&&GT[m.k]&&res.sc[m.k]!==null&&res.sc[m.k]<100).sort((a,b)=>res.sc[a.k]-res.sc[b.k]).forEach(m=>out.push(m.k));
  if(A.water<8)out.push('water'); if(A.energy>0)out.push('energy');
  if(!out.length)out.push('act','sleep');
  return [...new Set(out)].slice(0,4);
}
function goalHTML(le,res){
  const g=P.goal;
  if(!g){
    return `<div class="wrap"><div class="card"><h2>🎯 هدفي هذا الأسبوع</h2><p class="sub">اختر <b>هدفًا واحدًا</b> صغيرًا يمكنك تحقيقه. التغيير الصغير المتكرر يتفوق على الخطط الكبيرة.</p>
      ${suggestions(res).map(k=>`<button class="sug" data-g="${k}"><span class="ic">${GT[k].i}</span><span><b>${GT[k].t}</b><br><span class="tiny">${GT[k].n} أيام من 7</span></span></button>`).join('')}</div>
      ${histHTML()}</div>`;
  }
  const start=new Date(g.start+'T00:00:00'),todayS=iso(new Date()),cnt=Object.keys(g.done).length;
  const days=Array.from({length:7},(_,i)=>{const d=new Date(start);d.setDate(start.getDate()+i);return d;});
  const over=iso(days[6])<todayS, hit=cnt>=g.target;
  const dn=['ح','ن','ث','ر','خ','ج','س'];
  return `<div class="wrap"><div class="card"><h2>${GT[g.metric].i} هدف الأسبوع</h2><p style="font-size:18px;font-weight:700;margin:0">${g.text}</p>
    <p class="sub">المطلوب ${g.target} أيام من 7 · بدأ ${fmtDate(g.start)}</p>
    <div class="days">${days.map(d=>{const s=iso(d),fut=s>todayS;return `<button class="day${g.done[s]?' done':''}${s===todayS?' today':''}${fut?' future':''}" data-d="${s}" ${fut?'disabled':''}><span>${dn[d.getDay()]}</span><b>${g.done[s]?'✓':d.getDate()}</b></button>`;}).join('')}</div>
    <div class="pbar"><i style="width:${Math.min(100,cnt/g.target*100)}%"></i></div>
    <p class="tiny" style="margin:6px 0 0">${cnt} من ${g.target}</p>
    ${hit?`<div class="alert good" style="margin-top:12px">🎉 أحسنت! حققت هدف هذا الأسبوع.</div>`:''}
    ${over?`<div class="btns"><button class="btn pri" id="newGoal">ابدأ هدفًا جديدًا</button></div>`:`<div class="btns"><button class="btn line sm" id="chg">تغيير الهدف</button></div>`}</div>
    ${histHTML()}</div>`;
}
function histHTML(){
  const h=(P.goalHistory||[]).slice(-5).reverse(); if(!h.length)return '';
  return `<div class="card"><h3>📜 أهدافي السابقة</h3>${h.map(x=>`<div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--line)"><span>${GT[x.metric]?GT[x.metric].i+' '+GT[x.metric].t:x.metric}</span><b style="color:${x.count>=x.target?'var(--ok)':'var(--mut)'}">${x.count}/${x.target}</b></div>`).join('')}</div>`;
}
function bindGoal(le,res){
  document.querySelectorAll('.sug').forEach(b=>b.onclick=()=>{setGoal(b.dataset.g);renderApp();});
  document.querySelectorAll('.day').forEach(b=>b.onclick=()=>{
    const s=b.dataset.d; if(P.goal.done[s])delete P.goal.done[s]; else P.goal.done[s]=1; store.set(P); renderApp();
  });
  if($('newGoal'))$('newGoal').onclick=()=>{archiveGoal();store.set(P);renderApp();};
  if($('chg'))$('chg').onclick=()=>{if(confirm('تغيير الهدف سيحفظ تقدمك الحالي في السجل. متابعة؟')){archiveGoal();store.set(P);renderApp();}};
}

/* =================== البروفايل =================== */
function trend(entries){
  if(entries.length<2)return `<div class="sub" style="margin:0">سيظهر منحنى تقدمك هنا بعد التحديث الثاني لبياناتك.</div>`;
  const W_=300,H=120,pad=24,xs=entries.map((_,i)=>pad+i*(W_-2*pad)/(entries.length-1)),ys=entries.map(e=>H-pad-(e.total/100)*(H-2*pad));
  return `<svg viewBox="0 0 ${W_} ${H+16}" width="100%"><line x1="${pad}" x2="${W_-pad}" y1="${H-pad}" y2="${H-pad}" stroke="var(--line)"/>
   <polyline points="${xs.map((x,i)=>x+','+ys[i]).join(' ')}" fill="none" stroke="var(--gold)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/>
   ${entries.map((e,i)=>`<circle cx="${xs[i]}" cy="${ys[i]}" r="5" fill="var(--gold)"/><text x="${xs[i]}" y="${ys[i]-10}" text-anchor="middle" font-size="12" font-weight="700" fill="currentColor">${e.total}</text><text x="${xs[i]}" y="${H+10}" text-anchor="middle" font-size="9.5" fill="var(--mut)">${fmtDate(e.ts)}</text>`).join('')}</svg>`;
}
function badges(le,res){
  const first=P.entries[0],gh=P.goalHistory||[],g=P.goal,all=gh.concat(g?[{count:Object.keys(g.done).length,target:g.target}]:[]);
  return [
    {i:'🌱',t:'البداية',on:true},
    {i:'🎯',t:'حققت هدفًا',on:all.some(x=>x.count>=x.target)},
    {i:'🔥',t:'أسبوع كامل',on:all.some(x=>x.count>=7)},
    {i:'📈',t:'تحسّنت',on:P.entries.length>1&&le.total-first.total>=3},
    {i:'🌬️',t:'بلا نيكوتين',on:res.sc.nic===100},
    {i:'🛌',t:'نوم ذهبي',on:res.sc.sleep===100},
    {i:'👟',t:'نشيط',on:res.sc.act===100},
    {i:'🥦',t:'أكل متوازن',on:res.sc.diet>=80},
    {i:'🩺',t:'قياسات كاملة',on:res.n===8}
  ];
}
function meHTML(le,res){
  const first=P.entries[0],cur=le.M;
  const pills=[];
  if(res.bmi!==null)pills.push(`مؤشر الكتلة <b>${res.bmi.toFixed(1)}</b>`);
  if(cur.sbp!=null)pills.push(`الضغط <b>${cur.sbp}/${cur.dbp}</b>`);
  if(cur.fg!=null)pills.push(`سكر صائم <b>${cur.fg}</b>`);
  if(cur.a1c!=null)pills.push(`HbA1c <b>${cur.a1c}</b>`);
  if(cur.tc!=null)pills.push(`non-HDL <b>${cur.tc-cur.hdl}</b>`);
  if(res.egfr!==null)pills.push(`eGFR <b>${Math.round(res.egfr)}</b>`);
  if(cur.uacr!=null)pills.push(`UACR <b>${cur.uacr}</b>`);
  return `<div class="wrap">
  <div class="card" style="text-align:center"><div class="avatar" style="width:72px;height:72px;font-size:40px;margin:0 auto 6px;background:var(--gold-l)">${esc(P.avatar)}</div>
   <h2>${esc(P.nick)}</h2><div class="sub" style="margin:0">${CONFIG.YEARS[le.year-1]} · ${le.sex==='F'?'أنثى':'ذكر'} · ${le.age} سنة</div>
   <div class="code">${esc(P.code)}</div><div class="tiny">احتفظ بهذا الكود: يربط متابعتك على أي جهاز بدون اسمك.</div>
   <div class="btns" style="justify-content:center"><button class="btn sec sm" id="cp">نسخ الكود</button><button class="btn sec sm" id="ed">تعديل الاسم والأيقونة</button></div>
   <div id="edBox" class="hidden" style="margin-top:12px;text-align:start"><input type="text" id="nn" maxlength="14" value="${esc(P.nick)}" style="text-transform:none;letter-spacing:0;direction:rtl;text-align:start">
    <div class="avs" style="margin-top:10px" id="avs2">${AVATARS.map(a=>`<button type="button" data-a="${a}" class="${a===P.avatar?'on':''}">${a}</button>`).join('')}</div>
    <div class="btns"><button class="btn pri sm" id="sv">حفظ</button></div></div></div>

  <div class="card"><h3>📈 تقدّمي</h3>${trend(P.entries)}
   ${P.entries.length>1?`<div class="sub" style="margin:8px 0 0">من ${first.total} إلى ${le.total} (${le.total-first.total>=0?'+':''}${le.total-first.total})</div>`:''}</div>

  <div class="card"><h3>🏅 إنجازاتي</h3><div class="badges">${badges(le,res).map(b=>`<div class="bd${b.on?'':' off'}"><span>${b.i}</span>${b.t}</div>`).join('')}</div></div>

  <div class="card"><h3>🩺 قياساتي</h3>${pills.length?pills.map(p=>`<span class="pill">${p}</span>`).join(''):'<div class="sub">لم تُسجَّل قياسات بعد.</div>'}
   <div class="btns"><button class="btn sec sm" id="ms">${pills.length?'تحديث القياسات':'إضافة القياسات'}</button></div></div>

  <div class="card"><h3>⚙️ خصوصيتي</h3><p class="sub">الاسم المستعار والأيقونة والأهداف محفوظة على هذا الجهاز فقط. ما يُرسل للبحث هو إجاباتك وقياساتك مع الكود المجهول.</p>
   <div class="btns"><button class="btn line sm" id="ex">تنزيل بياناتي</button><button class="btn line sm" id="dl" style="color:var(--low)">حذف بياناتي من هذا الجهاز</button></div>
   <div class="btns"><button class="btn line sm" id="th">تبديل الوضع الفاتح/الداكن</button></div></div>
  <div class="foot">الأداة للتوعية والبحث العلمي ولا تُغني عن الفحص الطبي أو التشخيص.</div></div>`;
}
function bindMe(le,res){
  $('cp').onclick=()=>{try{navigator.clipboard.writeText(P.code);toast('تم نسخ الكود');}catch(e){toast(P.code);}};
  $('ed').onclick=()=>$('edBox').classList.toggle('hidden');
  let av=P.avatar;
  document.querySelectorAll('#avs2 button').forEach(b=>b.onclick=()=>{av=b.dataset.a;document.querySelectorAll('#avs2 button').forEach(x=>x.classList.toggle('on',x===b));});
  $('sv').onclick=()=>{P.nick=$('nn').value.trim()||P.nick;P.avatar=av;store.set(P);renderApp();toast('تم الحفظ');};
  $('ms').onclick=()=>startWizard('measures');
  $('ex').onclick=()=>{const b=new Blob([JSON.stringify(P,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='my-health-data.json';a.click();};
  $('dl').onclick=()=>{if(confirm('سيُحذف ملفك من هذا الجهاز (يمكنك العودة بكودك '+P.code+'). متابعة؟')){store.clear();P=null;startWelcome();}};
  $('th').onclick=()=>{const r=document.documentElement,dark=getComputedStyle(r).getPropertyValue('--bg').trim()==='#0A1423';r.dataset.theme=dark?'light':'dark';};
}

/* =================== الخادم =================== */
function payload(e,res){
  const A=e.A,M=e.M,s=res.sc;
  return {round:e.round,code:P.code,year:e.year,sex:e.sex,age:e.age,
    fast:A.fast,fried:A.fried,salty:A.salty,sweets:A.sweets,veg:A.veg,coffee:A.coffee,tea:A.tea,energy:A.energy,cola:A.cola,water:A.water,
    caffeine_mg:res.mg,sodium_mg:res.na,smoke:A.smoke,quit:A.quit||'',second:A.second,sleep:A.sleep,regular:A.regular,act_min:A.act,sitting:A.sitting,
    sbp:M.sbp??'',dbp:M.dbp??'',height:M.h??'',weight:M.w??'',bmi:res.bmi===null?'':+res.bmi.toFixed(1),
    fg:M.fg??'',a1c:M.a1c??'',tc:M.tc??'',hdl:M.hdl??'',creatinine:M.cre??'',egfr:res.egfr===null?'':Math.round(res.egfr),uacr:M.uacr??'',
    le8:res.total,n_metrics:res.n,s_diet:s.diet,s_act:s.act,s_nic:s.nic,s_sleep:s.sleep,s_bmi:s.bmi??'',s_lipid:s.lipid??'',s_gluc:s.gluc??'',s_bp:s.bp??'',
    f_smoke:['cig','vape','both'].includes(A.smoke)?1:0,f_sleep:A.sleep<6?1:0,f_inactive:A.act<150?1:0,f_water:A.water<6?1:0,f_caff:res.mg>CONFIG.CAFF_LIMIT?1:0,
    f_refer:(res.n>4||e.M.sbp!=null||e.M.fg!=null||e.M.a1c!=null||e.M.cre!=null||e.M.uacr!=null)?(res.refer.length?1:0):'',
    goal_metric:P.goal?P.goal.metric:'',goals_done:(P.goalHistory||[]).filter(x=>x.count>=x.target).length,
    note:res.refer.join(' | ')};
}
async function send(e,res){
  if(!CONFIG.API_URL){toast('وضع تجريبي: لم تُحفظ المشاركة على الخادم');return;}
  try{
    const r=await fetch(CONFIG.API_URL,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(payload(e,res))});
    const j=await r.json(); toast(j.ok?'✓ تم حفظ مشاركتك، شكرًا لك':'تعذر الحفظ: '+(j.error||'خطأ'));
  }catch(err){toast('تعذر الاتصال بالخادم، حاول لاحقًا');}
}
async function loadPeer(le,res){
  if(!CONFIG.API_URL)return;
  try{
    const r=await fetch(CONFIG.API_URL+'?action=stats&year='+le.year),j=await r.json();
    if(j.ok&&j.avg!==null&&$('peer'))$('peer').innerHTML=`<div class="card"><h3>👥 مقارنة مجهولة مع فرقتك</h3><div class="sub" style="margin:0">متوسط ${CONFIG.YEARS[le.year-1]}: <b>${j.avg}</b> (من ${j.n} مشاركًا بدون أسماء) · درجتك: <b>${res.total}</b></div></div>`;
  }catch(e){}
}

boot();
</script>
</body>
</html>
