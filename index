<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0B2442">
<title>جواز الصحة الوقائية</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#0B2442; --navy2:#16355F; --gold:#C6912E; --gold-l:#F7EDD6;
  --bg:#F3F5F9; --card:#FFFFFF; --soft:#EEF2F8; --line:#DDE3EC; --txt:#172538; --mut:#66758A;
  --ok:#2E8B63; --mid:#D39A1F; --low:#D2573B; --on-navy:#fff;
  --shadow:0 1px 2px rgba(11,36,66,.05),0 8px 24px rgba(11,36,66,.07);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0A1423; --card:#111F35; --soft:#17283F; --line:#243752; --txt:#E8EEF7; --mut:#94A3B8;
    --gold-l:#2A2415; --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.25);
  }
}
:root[data-theme="dark"]{
  --bg:#0A1423; --card:#111F35; --soft:#17283F; --line:#243752; --txt:#E8EEF7; --mut:#94A3B8;
  --gold-l:#2A2415; --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.25);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--txt);font-family:'Tajawal',system-ui,sans-serif;font-size:16px;line-height:1.65;padding-bottom:84px}
.wrap{max-width:720px;margin:0 auto;padding:16px}
.hidden{display:none!important}
button{font:inherit;cursor:pointer}
/* ---------- cards ---------- */
.card{background:var(--card);border-radius:22px;padding:18px;box-shadow:var(--shadow);margin-bottom:14px;border:1px solid var(--line)}
.card h2{margin:0 0 4px;font-size:20px;color:var(--navy)} :root[data-theme="dark"] .card h2{color:#fff}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .card h2{color:#fff}}
.card h3{margin:0 0 10px;font-size:16.5px;display:flex;align-items:center;gap:8px}
.sub{color:var(--mut);font-size:14px;margin:0 0 10px}
.note{background:var(--gold-l);border-radius:14px;padding:10px 14px;font-size:14px}
.tiny{font-size:12.5px;color:var(--mut)}
/* ---------- hero ---------- */
.hero{background:linear-gradient(150deg,var(--navy),var(--navy2) 70%);color:var(--on-navy);border-radius:26px;padding:20px;margin-bottom:14px;position:relative;overflow:hidden;box-shadow:var(--shadow)}
.hero::after{content:"";position:absolute;inset-inline-start:-60px;top:-60px;width:180px;height:180px;border-radius:50%;background:radial-gradient(circle,rgba(198,145,46,.35),transparent 70%)}
.hero .hi{display:flex;align-items:center;gap:10px;font-weight:700;font-size:18px;position:relative;z-index:1}
.avatar{width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;font-size:24px;flex:none}
.hero .row{display:flex;align-items:center;gap:16px;margin-top:14px;position:relative;z-index:1}
.ring{position:relative;width:132px;height:132px;flex:none}
.ring svg{transform:rotate(-90deg)}
.ring b{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:38px;line-height:1}
.ring b small{font-size:12px;font-weight:500;opacity:.75;margin-top:4px}
.lvl{display:inline-block;border-radius:20px;padding:3px 14px;font-weight:700;font-size:14px;color:#fff}
.hero .meta{font-size:14px;opacity:.9}
.delta{display:inline-flex;gap:4px;align-items:center;background:rgba(255,255,255,.14);border-radius:12px;padding:2px 10px;font-size:13px;margin-top:6px}
/* ---------- alerts ---------- */
.alert{border-radius:16px;padding:12px 14px;margin-bottom:12px;font-size:15px;border:1.5px solid}
.alert.refer{background:rgba(210,87,59,.10);border-color:var(--low)}
.alert.watch{background:rgba(211,154,31,.12);border-color:var(--mid)}
.alert.good{background:rgba(46,139,99,.10);border-color:var(--ok)}
/* ---------- metric grid ---------- */
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.mc{background:var(--soft);border-radius:18px;padding:12px;text-align:start;border:1.5px solid transparent;color:inherit;width:100%}
.mc.pri{border-color:var(--low)}
.mc .t{display:flex;justify-content:space-between;align-items:center;font-weight:700;font-size:14.5px}
.mc .v{font-size:24px;font-weight:800;margin:2px 0}
.mc .st{font-size:12.5px;color:var(--mut)}
.bar{height:7px;background:var(--line);border-radius:4px;overflow:hidden;margin-top:6px}
.bar i{display:block;height:100%;border-radius:4px}
.mc.empty{opacity:.75;border:1.5px dashed var(--line);background:transparent}
.mc .tip{display:none;font-size:13px;margin-top:8px;color:var(--txt)}
.mc.open .tip{display:block}
.badge{font-size:11px;background:var(--low);color:#fff;border-radius:8px;padding:0 7px}
/* ---------- focus card ---------- */
.focus{display:flex;gap:12px;align-items:center}
.focus .ic{font-size:34px}
.btn{border:0;border-radius:14px;padding:12px 18px;font-weight:700;font-size:15px}
.btn.pri{background:var(--gold);color:#fff}
.btn.sec{background:var(--soft);color:var(--txt)}
.btn.line{background:transparent;border:1.5px solid var(--line);color:var(--txt)}
.btn.sm{padding:8px 14px;font-size:13.5px;border-radius:12px}
.btns{display:flex;gap:10px;margin-top:16px}.btns .btn{flex:1}
/* ---------- what-if ---------- */
.simtop{display:flex;align-items:center;justify-content:center;gap:16px;background:var(--soft);border-radius:16px;padding:10px;margin-bottom:6px}
.simtop div{text-align:center}.simtop b{font-size:28px;display:block;line-height:1.1}.simtop small{color:var(--mut);font-size:12.5px}
.srow{margin:12px 0}.srow .t{display:flex;justify-content:space-between;font-size:14px}
input[type=range]{width:100%;accent-color:var(--gold)}
/* ---------- wizard ---------- */
.prog{display:flex;gap:6px;margin:0 0 14px}.prog i{flex:1;height:6px;border-radius:3px;background:var(--line)}.prog i.on{background:var(--gold)}
.q{margin:14px 0;padding:8px;border-radius:14px;border:1.5px solid transparent}.q.err{border-color:var(--low);background:rgba(210,87,59,.08)}
.ql{font-weight:700;margin-bottom:6px}.hint{font-size:13px;color:var(--mut);margin:-2px 0 6px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{min-width:46px;padding:10px 14px;border:1.5px solid var(--line);border-radius:14px;background:var(--card);color:var(--txt)}
.chip.on{background:var(--navy);border-color:var(--navy);color:#fff;font-weight:700}
:root[data-theme="dark"] .chip.on{background:var(--gold);border-color:var(--gold)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .chip.on{background:var(--gold);border-color:var(--gold)}}
input[type=number],input[type=text],select{width:100%;padding:12px;border:1.5px solid var(--line);border-radius:14px;font:inherit;background:var(--card);color:var(--txt)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
label.f{display:block;font-size:13.5px;color:var(--mut);margin-bottom:3px}
.chk{display:flex;gap:10px;align-items:flex-start;margin-top:12px;font-size:15px}.chk input{width:22px;height:22px;margin-top:3px;accent-color:var(--navy)}
.avs{display:flex;flex-wrap:wrap;gap:8px}.avs button{width:46px;height:46px;border-radius:50%;border:2px solid var(--line);background:var(--card);font-size:24px}
.avs button.on{border-color:var(--gold);background:var(--gold-l)}
.link{background:none;border:0;color:var(--gold);font-weight:700;padding:6px 0;text-decoration:underline}
/* ---------- goal ---------- */
.days{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin:10px 0}
.day{aspect-ratio:1;border-radius:14px;border:1.5px solid var(--line);background:var(--card);color:var(--txt);display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:12px;line-height:1.2}
.day b{font-size:16px}.day.done{background:var(--ok);border-color:var(--ok);color:#fff}.day.today{border-color:var(--gold);border-width:2.5px}.day.future{opacity:.4}
.sug{display:flex;gap:10px;align-items:center;width:100%;text-align:start;background:var(--soft);border:1.5px solid transparent;border-radius:16px;padding:12px;margin-bottom:8px;color:inherit}
.sug:active{border-color:var(--gold)}.sug .ic{font-size:26px}
.pbar{height:12px;background:var(--line);border-radius:6px;overflow:hidden}.pbar i{display:block;height:100%;background:linear-gradient(90deg,var(--gold),#E4B25A);border-radius:6px;transition:width .3s}
/* ---------- badges / profile ---------- */
.badges{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.bd{text-align:center;background:var(--soft);border-radius:16px;padding:10px 4px;font-size:12.5px}
.bd span{display:block;font-size:28px}.bd.off{opacity:.38;filter:grayscale(1)}
.pill{display:inline-block;background:var(--soft);border-radius:12px;padding:5px 11px;margin:3px 3px 0 0;font-size:14px}
.code{direction:ltr;text-align:center;font-size:22px;font-weight:800;letter-spacing:3px;background:var(--gold-l);border-radius:14px;padding:10px;margin:6px 0}
/* ---------- nav ---------- */
nav{position:fixed;bottom:0;inset-inline:0;background:color-mix(in srgb,var(--card) 88%,transparent);backdrop-filter:blur(14px);border-top:1px solid var(--line);display:flex;justify-content:center;padding:6px 8px calc(6px + env(safe-area-inset-bottom));z-index:10}
nav .in{display:flex;max-width:720px;width:100%;gap:4px}
nav button{flex:1;background:none;border:0;padding:6px;border-radius:14px;color:var(--mut);font-size:12.5px;font-weight:500;display:flex;flex-direction:column;align-items:center;gap:0}
nav button span{font-size:22px;line-height:1.2}
nav button.on{color:var(--navy);background:var(--gold-l);font-weight:700}
:root[data-theme="dark"] nav button.on{color:var(--gold)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) nav button.on{color:var(--gold)}}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 0;max-width:720px;margin:0 auto}
.topbar b{font-size:17px}.topbar small{color:var(--mut);display:block;font-size:12.5px}
.toast{position:fixed;bottom:96px;inset-inline:16px;max-width:420px;margin:0 auto;background:var(--navy);color:#fff;border-radius:14px;padding:10px 14px;font-size:14px;text-align:center;z-index:20;box-shadow:var(--shadow)}
.foot{font-size:12.5px;color:var(--mut);text-align:center;margin:6px 0 20px}
@media print{nav,.topbar,.btns,.noprint,.sim{display:none!important}body{background:#fff;padding:0}.card,.hero{box-shadow:none}}
</style>
</head>
<body>
<div id="top"></div>
<div class="wrap" id="app"></div>
<nav id="nav" class="hidden"><div class="in">
  <button data-t="dash"><span>📊</span>لوحتي</button>
  <button data-t="goal"><span>🎯</span>هدفي</button>
  <button data-t="me"><span>👤</span>بروفايلي</button>
</div></nav>
<div id="toast" class="toast hidden"></div>

<script>
/* =================== إعدادات (عدّليها) =================== */
const CONFIG = {
  API_URL: '',   https://script.google.com/macros/s/AKfycbwYC1axpa5UsRLjp5vLL-D4G8_XbLxh4rxzRJaWNJAuwzYjHJh02W0lEGk2RX-585jHwQ/exec
  FACULTY: 'كلية التمريض – جامعة المنصورة الأهلية',
  ETHICS_NO: '', // رقم موافقة لجنة أخلاقيات البحث
  YEARS: ['الفرقة الأولى','الفرقة الثانية','الفرقة الثالثة','الفرقة الرابعة (التخرج)'],
  CAFF_LIMIT: 400,   // مجم/يوم
  SODIUM_LIMIT: 2300,// مجم/يوم (إرشادات 2025، والأفضل أقل من 1500)
  FOLLOWUP_DAYS: 56  // موعد المتابعة المقترح (8 أسابيع)
};

/* =================== أدوات =================== */
const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));
const iso=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const fmtDate=s=>new Date(s).toLocaleDateString('ar-EG-u-nu-latn',{day:'numeric',month:'long'});
let _mem=null;
const store={
  get(){try{const v=localStorage.getItem('hp_v2');return v?JSON.parse(v):_mem}catch(e){return _mem}},
  set(v){_mem=v;try{localStorage.setItem('hp_v2',JSON.stringify(v))}catch(e){}},
  clear(){_mem=null;try{localStorage.removeItem('hp_v2')}catch(e){}}
};
function toast(t){const e=$('toast');e.textContent=t;e.classList.remove('hidden');clearTimeout(toast._t);toast._t=setTimeout(()=>e.classList.add('hidden'),2600);}

/* =================== نظام Life's Essential 8 (AHA 2022) ===================
 الجداول مأخوذة من منهجية Healthy People 2030 للمقياس.
 ملاحظات: (1) درجة الغذاء هنا مُبسّطة من أسئلة تكرار وليست HEI/MEPA الرسمية.
          (2) سكر الصيام يُستخدم بديلًا عن HbA1c عند غيابه.
          (3) درجة الفرد = متوسط المؤشرات المتاحة فقط.                         */
const MET=[
 {k:'diet', n:'الغذاء',        i:'🥗', beh:true, note:'مبسّط'},
 {k:'act',  n:'النشاط البدني', i:'🏃', beh:true},
 {k:'nic',  n:'التدخين والنيكوتين', i:'🚭', beh:true},
 {k:'sleep',n:'النوم',         i:'🌙', beh:true},
 {k:'bmi',  n:'وزن الجسم',     i:'⚖️'},
 {k:'lipid',n:'الدهون',        i:'🧪'},
 {k:'gluc', n:'سكر الدم',      i:'🍬'},
 {k:'bp',   n:'ضغط الدم',      i:'❤️'}
];
const TIPS={
 diet:'قلّل الوجبات السريعة والمقليات والمخللات تدريجيًا، وزد الخضار والفاكهة. الملح الزائد يرفع الضغط ويُجهد الكلى.',
 act:'الهدف 150 دقيقة أسبوعيًا من نشاط متوسط الشدة، كالمشي السريع. ابدأ بـ 30 دقيقة ثلاث مرات.',
 nic:'التدخين من أقوى عوامل خطر القلب والأوعية. الفيب أدلته أحدث وتشير إلى زيادة طفيفة في خطر ارتفاع الضغط، ولا يُعد بديلًا آمنًا. الإقلاع الكامل أفضل، ويمكن طلب دعم من عيادة الكلية.',
 sleep:'الهدف 7 إلى 9 ساعات بمواعيد ثابتة، حتى في الإجازة.',
 bmi:'التدرج في خفض الوزن أهم من السرعة؛ نقص 5% من الوزن يُحدث فرقًا في الضغط والسكر.',
 lipid:'قلّل الدهون المشبعة والمقليات وزد الألياف والأسماك.',
 gluc:'قلّل المشروبات المحلاة والحلويات وتحرك يوميًا.',
 bp:'قلّل الملح وتحرك يوميًا. أعد القياس مرتين بعد راحة 5 دقائق لتأكيد القراءة.'
};
const sDiet=a=>{const u=(a.fast+a.fried+a.salty+a.sweets)/28,h=a.veg/7,x=100*(.7*(1-u)+.3*h);return x>=85?100:x>=70?80:x>=50?50:x>=30?25:0;};
const sAct=m=>m>=150?100:m>=120?90:m>=90?80:m>=60?60:m>=30?40:m>=1?20:0;
const sSleep=h=>h<4?0:h<5?20:h<6?40:h<7?70:h<9?100:h<10?90:40;
const sNic=a=>{let s=a.smoke==='never'?100:a.smoke==='former'?(a.quit==='5+'?75:a.quit==='1-5'?50:25):a.smoke==='vape'?25:0;if(a.second&&s>0)s=Math.max(0,s-20);return s;};
const sBmi=b=>b<25?100:b<30?70:b<35?30:b<40?15:0;
const sBp=(s,d)=>(s>=160||d>=100)?0:(s>=140||d>=90)?25:(s>=130||d>=80)?50:s>=120?75:100;
const sLip=n=>n<130?100:n<160?60:n<190?40:n<220?20:0;
const sGlu=m=>{if(m.a1c!=null){const a=m.a1c;return a<5.7?100:a<6.5?60:a<7?40:a<8?30:a<9?20:a<10?10:0;}
  if(m.fg!=null){return m.fg<100?100:m.fg<126?60:40;} return null;};
function egfrCalc(scr,age,sex){const f=sex==='F',k=f?.7:.9,a=f?-.241:-.302;return 142*Math.pow(Math.min(scr/k,1),a)*Math.pow(Math.max(scr/k,1),-1.2)*Math.pow(.9938,age)*(f?1.012:1);}
const caffMg=a=>a.coffee*80+a.tea*45+a.energy*100+a.cola*35;
const sodiumMg=a=>Math.round((a.fast*1500+a.fried*800+a.salty*900)/7);

function compute(A,M,age,sex){
  const sc={diet:sDiet(A),act:sAct(A.act),nic:sNic(A),sleep:sSleep(A.sleep),bmi:null,lipid:null,gluc:null,bp:null};
  const bmi=(M.h&&M.w)?M.w/Math.pow(M.h/100,2):null;
  if(bmi!==null)sc.bmi=sBmi(bmi);
  if(M.tc!=null&&M.hdl!=null)sc.lipid=sLip(M.tc-M.hdl);
  sc.gluc=sGlu(M);
  if(M.sbp!=null&&M.dbp!=null)sc.bp=sBp(M.sbp,M.dbp);
  const v=Object.values(sc).filter(x=>x!==null);
  const total=Math.round(v.reduce((a,b)=>a+b,0)/v.length);
  const egfr=M.cre!=null?egfrCalc(M.cre,age,sex):null;
  const refer=[],watch=[];
  if(M.sbp!=null){ if(M.sbp>=140||M.dbp>=90)refer.push(`ضغط الدم ${M.sbp}/${M.dbp} (أعد القياس مرتين بعد راحة 5 دقائق)`);
    else if(M.sbp>=130||M.dbp>=80)watch.push(`ضغط الدم ${M.sbp}/${M.dbp} أعلى من المثالي`); }
  if((M.a1c!=null&&M.a1c>=6.5)||(M.fg!=null&&M.fg>=126))refer.push('سكر الدم في نطاق يستحق التأكيد بتحليل');
  else if((M.a1c!=null&&M.a1c>=5.7)||(M.fg!=null&&M.fg>=100))watch.push('سكر الدم في نطاق ما قبل السكر');
  if(egfr!==null){ if(egfr<60)refer.push(`معدل الترشيح الكلوي المقدّر ${Math.round(egfr)} (يُعاد التحليل)`); else if(egfr<90)watch.push(`معدل الترشيح الكلوي ${Math.round(egfr)} أقل قليلًا من 90`); }
  if(M.uacr!=null){ if(M.uacr>=30)refer.push(`ألبومين البول ${M.uacr} مجم/جم (يُؤكَّد بتكرار التحليل)`); }
  if(bmi!==null){ if(bmi>=30)watch.push(`مؤشر كتلة الجسم ${bmi.toFixed(1)} (سمنة)`); else if(bmi>=25)watch.push(`مؤشر كتلة الجسم ${bmi.toFixed(1)} (زيادة وزن)`); else if(bmi<18.5)watch.push(`مؤشر كتلة الجسم ${bmi.toFixed(1)} أقل من المعدل`); }
  return {sc,total,n:v.length,bmi,egfr,refer,watch,mg:caffMg(A),na:sodiumMg(A)};
}
const lvOf=x=>x>=80?{t:'مرتفعة',c:'var(--ok)'}:x>=50?{t:'متوسطة',c:'var(--mid)'}:{t:'منخفضة',c:'var(--low)'};
const colOf=x=>x>=80?'var(--ok)':x>=50?'var(--mid)':'var(--low)';

/* =================== أسئلة الاستبيان =================== */
const rg=(a,b,last)=>Array.from({length:b-a+1},(_,i)=>({v:a+i,l:(a+i===b&&last)?last:String(a+i)}));
const QS={
  year:{l:'الفرقة الدراسية',o:CONFIG.YEARS.map((l,i)=>({v:i+1,l}))},
  sex:{l:'النوع',o:[{v:'M',l:'ذكر'},{v:'F',l:'أنثى'}]},
  fast:{l:'وجبات سريعة (برجر / شاورما / بيتزا)',h:'كم يومًا في الأسبوع؟',o:rg(0,7)},
  fried:{l:'مقليات (طعمية / بطاطس / فراخ مقلية)',h:'كم يومًا في الأسبوع؟',o:rg(0,7)},
  salty:{l:'إندومي أو شيبسي أو مخللات',h:'كم يومًا في الأسبوع؟',o:rg(0,7)},
  sweets:{l:'حلويات أو عصائر معلبة',h:'كم يومًا في الأسبوع؟',o:rg(0,7)},
