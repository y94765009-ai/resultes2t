     const v=res.sc[m.k];
     if(v===null)return `<button class="mc empty" data-act="measures"><div class="t"><span>${m.i} ${m.n}</span></div><div class="st" style="margin-top:6px">＋ أضف القياس لتكتمل صورتك</div></button>`;
     return `<button class="mc${priSet.has(m.k)?' pri':''}" data-m="${m.k}"><div class="t"><span>${m.i} ${m.n}</span>${priSet.has(m.k)?'<span class="badge">أولوية</span>':''}</div>
