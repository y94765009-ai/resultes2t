/* =================== الحالة =================== */
let P=store.get();            // الملف الشخصي المحفوظ على الجهاز
let view='boot', tab='dash';
let W=null;                   // حالة المعالج {mode,step,A,M,age,...}
const lastEntry=()=>P&&P.entries&&P.entries.length?P.entries[P.entries.length-1]:null;

/* =================== التنقل العام =================== */
function boot(){
  document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>{tab=b.dataset.t;renderApp();window.scrollTo({top:0});});
  if(P&&P.entries&&P.entries.length)goApp('dash'); else startWelcome();
}
function setNav(on){ $('nav').classList.toggle('hidden',!on); }
function goApp(t){ view='app'; tab=t||tab; setNav(true); renderApp(); window.scrollTo({top:0}); }
function topbar(){
  return `<div class="topbar"><div><b>🛡️ جواز الصحة الوقائية</b><small>${esc(CONFIG.FACULTY)}</small></div></div>`;
}

/* =================== الترحيب ===================*/
let wel={nick:'',avatar:AVATARS[0],recover:false};
