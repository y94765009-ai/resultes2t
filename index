  <div class="card"><h2>اختر هويتك على اللوحة</h2><p class="sub">الاسم المستعار والأيقونة تبقى على جهازك فقط ولا تُرسل لأحد.</p>
    <input type="text" id="nick" maxlength="14" placeholder="اسم مستعار (مثال: نجم)" value="${esc(wel.nick)}" style="text-transform:none;letter-spacing:0;direction:rtl;text-align:start">
    <div class="avs" style="margin-top:12px" id="avs">${AVATARS.map(a=>`<button type="button" data-a="${a}" class="${a===wel.avatar?'on':''}">${a}</button>`).join('')}</div>
    <div class="note" style="margin-top:14px">المشاركة اختيارية وبدون اسم حقيقي، ويمكنك التوقف في أي وقت. تُستخدم البيانات المجمّعة فقط للبحث العلمي والتوعية.${CONFIG.ETHICS_NO?`<br>رقم موافقة لجنة الأخلاقيات: ${esc(CONFIG.ETHICS_NO)}`:''}</div>
    <label class="chk"><input type="checkbox" id="consent"><span>أوافق على المشاركة في هذا البحث، وأفهم أن بياناتي مجهولة الهوية.</span></label>
    ${CONFIG.API_URL?'':'<div class="note" style="margin-top:12px">وضع تجريبي: لن تُحفظ البيانات على الخادم.</div>'}
    <div class="btns"><button class="btn pri" id="go">ابدأ</button></div>
    <div style="text-align:center;margin-top:8px"><button class="link" id="rec">شاركت من قبل ولدي كود</button></div>
    <div id="recBox" class="hidden" style="margin-top:8px"><input type="text" id="recIn" maxlength="12" placeholder="HP-XXXXX" style="direction:ltr;text-align:center;letter-spacing:2px;text-transform:uppercase"></div>
  </div></div>`;
  document.querySelectorAll('#avs button').forEach(b=>b.onclick=()=>{wel.avatar=b.dataset.a;document.querySelectorAll('#avs button').forEach(x=>x.classList.toggle('on',x===b));});
